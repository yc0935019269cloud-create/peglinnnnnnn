    - Term: Orbs/self_damage_boost_desc2
      TermType: 0
      Languages:
      - '<style=dmg_bonus>Gains +{[SELF_DMG_BOOST_DMG]}/+{[SELF_DMG_BOOST_CRIT]}</style> for each time you''ve taken <style=damage>self-damage</style> this battle'
