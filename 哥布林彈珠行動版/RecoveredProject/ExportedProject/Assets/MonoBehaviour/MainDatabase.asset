      - title: es
        value: Dénoncer le Peglin cuistot
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Delatar al Chef Peglin
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-TW
        value: 揭发哥布林大厨
        type: 4
