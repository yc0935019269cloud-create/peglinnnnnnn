        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "「お任せえ……あれ……」\n「<style=loseOrb>[var=chosenOrb]</style>」が無くなり、カバンが軽くなった。"
        type: 4
        typeString: CustomFieldType_Localization
      - title: sv
        value: "\"네 명대로.\"\n [var=chosenOrb]가 사라진 당신의 가방이 더 가볍게 느껴집니다.\""
        type: 4
