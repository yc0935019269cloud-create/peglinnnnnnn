      - title: Dialogue Text
        value: One of the spirits whisks away your <style=loseOrb>[var=orb1Name]</style> as they <style=subtle><incr>disappear into thin air...</incr></style>
        type: 0
        typeString: CustomFieldType_Text
      - title: Parenthetical
        value:
