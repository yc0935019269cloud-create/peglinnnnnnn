      - title: Dialogue Text
        value: The hammer is quite heavy for your <style=peglin>tiny tiny arms</style> but you should be able to make some use of it with your special satchel.
        type: 0
        typeString: CustomFieldType_Text
      - title: Parenthetical
        value:
        type: 0
        typeString: CustomFieldType_Text
      - title: Audio Files
        value: '[]'
