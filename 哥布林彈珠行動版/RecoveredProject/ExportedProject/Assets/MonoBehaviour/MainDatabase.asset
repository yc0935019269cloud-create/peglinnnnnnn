      - title: nl
        value: "\"Sssofort erledigt.\"\nDeine Tasche ist leichter, nachdem das [var=chosenOrb] entfernt wurde."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "\"Bessschouw het als gedaan.\"\nJe schoudertas is lichter nu je [var=chosenOrb] is verwijderd."
        type: 4
