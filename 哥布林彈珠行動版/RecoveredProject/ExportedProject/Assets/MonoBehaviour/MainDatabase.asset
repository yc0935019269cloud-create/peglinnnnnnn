      - title: Dialogue Text
        value: You easily make it away from the tired old brick slime.
        type: 0
        typeString: CustomFieldType_Text
      - title: Parenthetical
        value:
        type: 0
        typeString: CustomFieldType_Text
      - title: Audio Files
        value: '[]'
