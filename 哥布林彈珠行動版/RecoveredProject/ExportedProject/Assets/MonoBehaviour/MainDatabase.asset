        type: 4
        typeString: CustomFieldType_Localization
      - title: tr
        value: Uciekaj!
        type: 4
        typeString: CustomFieldType_Localization
      - title: sk
        value: Topukla!
        type: 4
        typeString: CustomFieldType_Localization
      - title: ua
        value: Utiecť!
        type: 4
        typeString: CustomFieldType_Localization
