        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "\"Consssider it done.\"\nYour [var=chosenOrb] has been upgraded to [var=upgradedOrb]."
        type: 0
        typeString: CustomFieldType_Text
      - title: Parenthetical
        value:
        type: 0
