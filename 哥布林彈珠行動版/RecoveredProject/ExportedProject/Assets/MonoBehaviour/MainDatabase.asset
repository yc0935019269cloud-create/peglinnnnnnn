      - title: nl
        value: Trickse die Ziegelschleime aus <style=stone>(+3 Steine)</style>
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Misleid de stenen <style=stone>(+3 Stenen)</style>
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt-BR
        value: Inganna i mattoni <style=stone>(+3 Sassosfere)</style>
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: Enganar os tijolos <style=stone>(+3 Cascalhorbes)</style>.
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: Обхитрить слизней <style=stone>(+3 камня)</style>
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: 引誘方磚史萊姆們（<style=stone>+ 3 顆圓石彈珠</style>）
        type: 4
        typeString: CustomFieldType_Localization
      - title: sv
        value: 벽돌들을 속이기 <style=stone>(펩볼 +3개)</style>
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value:
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: Tenter de ruser les briques <style=stone>(+3 Cailloux)</style>
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Engañar a los ladrillos <style=stone>(+3 Guijarros)</style>
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-TW
        value: 引诱砖头史莱姆<style=stone>（ + 3 石头）</style>
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
