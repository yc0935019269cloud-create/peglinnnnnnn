      - title: Dialogue Text
        value: Catch a ride! (<style=stone>+[var=ride_stones] Stones</style>, <style=damage>Random Navigation</style>)
        type: 0
        typeString: CustomFieldType_Text
      - title: Parenthetical
        value:
        type: 0
