      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value:
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "<style=damage>You lose the flip</style> and the <style=peglin>other Peglin's</style> eyes gleam with mischief as you feel a little weaker.\n\"Thanks for that, care to flip again?\""
        type: 0
        typeString: CustomFieldType_Text
      - title: Parenthetical
        value:
        type: 0
        typeString: CustomFieldType_Text
      - title: Audio Files
        value: '[]'
        type: 3
        typeString: CustomFieldType_Files
      - title: Sequence
        value:
        type: 0
        typeString: CustomFieldType_Text
      - title: en
        value: "<style=damage>You lose the flip</style> and the <style=peglin>other Peglin's</style> eyes gleam with mischief as you feel a little weaker.\n\"Thanks for that, care to flip again?\""
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value:
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: '<style=damage>Vous perdez le pari</style> et les yeux de <style=peglin>l’autre Peglin</style> brillent de malice alors que vous vous sentez un peu plus faible. « Merci bien. Vous voulez retenter votre chance ? »'
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: '<style=damage>Pierdes el lanzamiento</style>, y los ojos del <style=peglin>otro Peglin</style> brillan con picardía mientras te sientes más débil.  "Muchas gracias, ¿te gustaría intentar de nuevo?"'
        type: 4
        typeString: CustomFieldType_Localization
      - title: nl
        value: "<style=damage>Du verlierst das Glücksspiel</style> und die Augen des anderen <style=peglin>Peglin</style> schimmern vor Schadenfreude. Du fühlst dich mit einem Mal schwächer.\n\"Danke dafür. Willst du gleich nochmal?\""
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "<style=damage>Je verliest de toss</style> en de ogen van de <style=peglin>andere Peglin</style> glinsteren ondeugend terwijl jij je een beetje zwakker voelt.\n\"Bedankt daarvoor, wil je nog een keertje tossen?\""
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt-BR
        value: '<style=damage>Hai perso al lancio</style> e gli occhi <style=peglin>del vecchio Peglin</style> brillano con malizia, mentre tu ti senti più debole. "Grazie mille, ti va un altro lancio?"'
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: '<style=damage>Você perde a aposta</style> e os olhos do <style=peglin>outro Peglin</style> brilham com maldade enquanto você se sente um pouco mais fraco. "Obrigado por isso, quer jogar mais uma vez?"'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: '<style=damage>Вы проиграли.</style> Глаза <style=peglin>другого пеглина</style> недобро блестят, когда вам становится немного хуже. «Спасибо за это. Хочешь бросить еще раз?»'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-TW
        value: "<style=damage>你输了</style>，<style=peglin>赌徒哥布林</style>的眼中闪烁着狡猾的目光，这让你感到有些无奈。\n“太感谢你了，还想再来一局吗？”"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "<style=damage>你輸掉賭局！</style><style=peglin>賭徒哥布林</style>用不懷好意的目光盯著稍感失落的你。\n「太感謝你了，要再來一局嗎？」"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "<style=damage>ギャンブルに負けた……</style>少し弱気になったのか、\n<style=peglin>年老いたペグリン</style>の瞳がやけにギラついて見える。\n「へへ、ありがとよ……もっかいやるかい？」"
        type: 4
        typeString: CustomFieldType_Localization
      - title: sv
        value: "당신이 칩 뒤집기에서 <style=damage>패배</style>하자 <style=peglin>다른 페글린</style>의 장난기 가득한 눈이 빛나더니 당신의 힘이 약해지는 것이 느껴집니다. \n \"그거 고맙네, 한번 더 해보겠는가?\""
        type: 4
        typeString: CustomFieldType_Localization
      - title: pl
        value:
        type: 4
        typeString: CustomFieldType_Localization
      - title: tr
        value: "<style=damage>Przegrałeś rzut,</style> a <style=peglin>oczy drugiego Peglina</style> lśnią psotliwie gdy zauważa, że czujesz się nieco słabszy.\n\"Dzięki, może kolejny rzut?\""
        type: 4
        typeString: CustomFieldType_Localization
      - title: sk
        value: "<style=damage>Çip yanlış yüze düştü</style> ve sen daha zayıf hissederken <style=peglin>diğer Peglinin</style> gözleri hain bir ışıkla parıldadı.\n\"Ahh bu iyi geldi, bir daha denemek ister misin?\""
        type: 4
        typeString: CustomFieldType_Localization
      - title: ua
        value:
        type: 4
        typeString: CustomFieldType_Localization
