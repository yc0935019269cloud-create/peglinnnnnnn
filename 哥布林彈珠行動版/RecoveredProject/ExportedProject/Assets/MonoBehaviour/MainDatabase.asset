      - title: Menu Text
        value:
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: '"Ohhhhhh hello there. It''s not often you see your kind around here, at least not angry and covered in <style=crystal>crystals</style>! I hope my brethren haven''t been giving you too much trouble... They get a little carried away stomping around sometimes!"'
        type: 0
        typeString: CustomFieldType_Text
      - title: Parenthetical
        value:
