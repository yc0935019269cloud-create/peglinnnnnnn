        typeString: CustomFieldType_Text
      - title: EventGuid
        value: 6d161ab1-b19a-43a4-86f1-b6ce10d4725c
        type: 0
        typeString:
      - title: en
        value: Catch a ride! (<style=stone>+[var=ride_stones] Pebballs</style>, <style=damage>Random Navigation</style>)
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value:
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: Monter en marche ! (<style=stone>+[var=ride_stones] Cailloux</style>, <style=damage>Navigation aléatoire</style>)
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: ¡Subirte! (<style=stone>+[var=ride_stones] Guijarros</style>, <style=damage>Navegación Aleatoria</style>)
        type: 4
        typeString: CustomFieldType_Localization
      - title: nl
        value: Nutz die Mitfahrgelegenheit! (<style=stone>+[var=ride_stones] Steine</style>, <style=damage>Zufällige Navigation</style>)
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Pak een ritje! (<style=stone>+[var=ride_stones] Stenen</style>, <style=damage>Willekeurige Navigatie</style>)
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt-BR
        value: Strappa un passaggio! (<style=stone>+[var=ride_stones] Sassosfere</style>, <style=damage>Navigazione casuale</style>)
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: Pegar uma carona! (<style=stone>+[var=ride_stones] Cascalhorbes</style>, <style=damage>seguir por uma direção aleatória</style>)
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: Поймать попутку! (<style=stone>+[var=ride_stones] Камней</style>, <style=damage>Случайный путь</style>)
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-TW
        value: 跳上矿车！（<style=stone> + [var=ride_stones] 石头</style>，<style=damage>随机选择下一关前进路线</style>）
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: 跳上礦車！（<style=stone>+ [var=ride_stones] 顆圓石彈珠</style>，<style=damage>隨機選擇前進路線</style>）
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: 飛び乗れ！（<style=stone>石ころ +[var=ride_stones]</style>、<style=damage>ランダムなルート選択</style>）
        type: 4
        typeString: CustomFieldType_Localization
      - title: sv
        value: 올라타기! (<style=stone>+ [var=ride_stones] 펩볼 </style>, <style=damage>무작위 이동</style>)
        type: 4
        typeString: CustomFieldType_Localization
      - title: pl
        value:
        type: 4
        typeString: CustomFieldType_Localization
      - title: tr
        value: Załap się na przejażdżkę! (<style=stone>+[var=ride_stones] Kamienie</style>, <style=damage>Losowy Kierunek</style>)
        type: 4
        typeString: CustomFieldType_Localization
      - title: sk
        value: Vagonun içine atla! (<style=stone>+[var=ride_stones] Taşlar</style>, <style=damage>Rastgele Navigasyon</style>)
        type: 4
        typeString: CustomFieldType_Localization
      - title: ua
        value:
        type: 4
        typeString: CustomFieldType_Localization
