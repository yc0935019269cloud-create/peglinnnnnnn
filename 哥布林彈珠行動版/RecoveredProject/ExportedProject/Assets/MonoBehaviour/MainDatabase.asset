      - title: Dialogue Text
        value: The earthly energy permeates you and your satchel. You continue on your way with a stronger earthly connection and stronger orbs to show for it.
        type: 0
        typeString: CustomFieldType_Text
      - title: Parenthetical
        value:
        type: 0
        typeString: CustomFieldType_Text
      - title: Audio Files
        value: '[]'
