    - id: 4
      fields:
      - title: Title
        value:
        type: 0
        typeString: CustomFieldType_Text
      - title: Pictures
        value: '[]'
        type: 3
        typeString: CustomFieldType_Files
      - title: Description
        value:
        type: 0
